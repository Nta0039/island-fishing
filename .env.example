# Copy this file to `.env` and fill in the two values, then run `npm start`.
#
#   copy .env.example .env
#
# `.env` is gitignored — never commit the real key.
#
# Where to find these: Supabase dashboard -> your island-fishing project
#   -> Settings -> API
#     Project URL        -> SUPABASE_URL
#     service_role secret-> SUPABASE_SERVICE_KEY   (click "Reveal", keep it private)
#
# The service_role key bypasses row level security. It belongs on the
# server only. Never put it in public/ or in anything the browser loads.
#
# Leave both blank to run without persistence: the game works exactly as
# before, it just will not remember anyone between sessions.

SUPABASE_URL=https://gadjymlhpzfadyqoeosu.supabase.co
SUPABASE_SERVICE_KEY=
